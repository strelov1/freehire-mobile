# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (Expo public values are still environment-specific)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Claude Code worktrees
.claude/worktrees/

# Agent scratch directory
.agents/


# Git worktrees checked out inside the repo (the .claude/ ones are ignored
# above). Not ours to commit, and jest would otherwise run their tests too.
.worktrees/

# The App Store Connect scripts import a shared module now, so running one
# leaves bytecode behind.
scripts/__pycache__/
